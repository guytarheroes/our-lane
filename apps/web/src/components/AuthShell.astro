---
import { LANG_COOKIE, dict, validLang } from '../lib/i18n.js';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const t = dict(validLang(Astro.cookies.get(LANG_COOKIE)?.value));
---

<div class="grid min-h-dvh lg:grid-cols-[1.05fr_1fr]">
  {/* แผงแบรนด์ — โผล่เฉพาะจอกว้าง มือถือไม่ต้องเสียพื้นที่ให้ของตกแต่ง
      ตั้งใจไม่ใส่ชื่อคู่รักหรือจำนวนวันตรงนี้ เพราะนี่คือหน้าเดียวที่คนนอกเปิดได้ */}
  <aside
    class="hidden flex-col justify-between bg-accent px-14 py-16 text-on-accent lg:flex"
    aria-hidden="true"
  >
    <p class="flex items-center gap-2.5">
      <span class="pulse block size-2 rounded-full bg-on-accent"></span>
      <span class="pixel opacity-80">
        our memory lane
      </span>
    </p>

    {/* คีย์นี้มี <br /> อยู่ในตัว — จุดตัดบรรทัดคนละที่ระหว่างสองภาษา ตัดเองไม่ได้ */}
    <p class="font-display max-w-[16ch] text-[44px] leading-[1.35] text-balance" set:html={t('app.brandLine')} />

    <p class="max-w-[34ch] text-[14px] leading-[1.9] opacity-75">{t('app.taglineShort')}</p>
  </aside>

  <main class="flex items-center justify-center px-5 py-12 sm:px-10 sm:py-16">
    <div class="w-full max-w-sm">
      <p class="mb-6 flex items-center gap-2.5 lg:hidden">
        <span class="pulse block size-2 rounded-full bg-accent"></span>
        <span class="pixel text-muted">
          our memory lane
        </span>
      </p>

      <h1 class="font-display text-[28px] leading-[1.4] text-text sm:text-[32px]">{title}</h1>
      {subtitle && <p class="mt-2 text-[14px] leading-[1.9] text-muted">{subtitle}</p>}

      <slot />
    </div>
  </main>
</div>
