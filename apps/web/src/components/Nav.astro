---
import { LANG_COOKIE, dict, validLang } from '../lib/i18n.js';
import { ICON, SVG_PROPS } from '../lib/icons.js';

interface Props {
  current: 'timeline' | 'calendar' | 'admin' | 'settings';
}

const { current } = Astro.props;
const t = dict(validLang(Astro.cookies.get(LANG_COOKIE)?.value));
const user = Astro.locals.user;

const pill = 'inline-flex min-h-9 flex-none items-center rounded-full px-3.5 text-[13px] font-medium sm:px-4';
const on = `${pill} bg-accent text-on-accent`;
const off = `${pill} border border-line text-muted`;
const item = 'flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-left text-[13.5px]';
const itemIco = 'size-4 flex-none opacity-70';
const divide = 'my-1 block h-px bg-line';

// ชื่อย่อบน avatar — ไม่มีชื่อก็เอาตัวแรกของอีเมล ไม่มีอะไรเลยก็ขีดกลาง
const initial = (user?.name?.trim() || user?.email || '—').trim().charAt(0).toUpperCase();
---

<nav class="fixed inset-x-0 top-0 z-30 h-14 border-b border-line bg-bg" aria-label={t('nav.menu')}>
  <div class="mx-auto flex h-full w-full max-w-5xl items-center gap-2 px-5 sm:px-12">
    <p class="flex flex-none items-center gap-2.5">
      <span class="pulse block size-2 rounded-full bg-accent"></span>
      {/* จอแคบเหลือแค่จุด ไม่งั้นแถบเดียวใส่ทั้ง wordmark + 2 pill + 2 ปุ่มไม่พอที่ 320px */}
      <span class="pixel hidden text-muted sm:inline">
        our memory lane
      </span>
    </p>

    <a href="/" class={current === 'timeline' ? on : off} aria-current={current === 'timeline' ? 'page' : undefined}>
      {t('nav.timeline')}
    </a>
    <a href="/calendar" class={current === 'calendar' ? on : off} aria-current={current === 'calendar' ? 'page' : undefined}>
      {t('nav.calendar')}
    </a>

    <a
      href="/admin"
      aria-label={t('nav.add')}
      aria-current={current === 'admin' ? 'page' : undefined}
      class:list={[
        'ml-auto inline-flex size-9 flex-none items-center justify-center rounded-full',
        current === 'admin' ? 'bg-accent text-on-accent' : 'border border-accent-ink/40 text-accent-ink',
      ]}
    >
      <svg {...SVG_PROPS} stroke-width="2" class="size-[17px]" set:html={ICON.plus} />
    </a>

    {/* <details> คือ disclosure ของ HTML เอง — เปิดปิดได้โดยไม่ต้องมี JS
        และ screen reader ประกาศสถานะย่อ/ขยายให้เอง (แพตเทิร์นเดียวกับ date picker ในปฏิทิน) */}
    <details class="relative flex-none">
      <summary
        class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full border border-alt-muted/45 bg-alt-bg text-[14px] font-medium text-alt-ink marker:hidden [&::-webkit-details-marker]:hidden"
        aria-label={t('nav.account')}
      >
        {initial}
      </summary>

      <div
        class="absolute top-full right-0 z-20 mt-2 w-56 rounded-2xl border border-line bg-surface p-2 shadow-[0_8px_24px_rgba(133,41,54,0.18)]"
      >
        <p class="px-3 py-2">
          <span class="block truncate text-[14px] text-text">{user?.name || t('nav.noName')}</span>
          <span class="block truncate font-mono text-[11px] text-muted">{user?.email}</span>
        </p>

        <span class={divide}></span>

        {/* ของที่เป็น "เนื้อหา" อยู่กลุ่มบน */}
        <a
          href="/admin#list"
          class:list={[item, current === 'admin' ? 'bg-accent text-on-accent' : 'text-body hover:bg-field']}
        >
          <svg {...SVG_PROPS} class={itemIco} set:html={ICON.list} />
          {t('nav.myList')}
        </a>

        <span class={divide}></span>

        {/* ตั้งค่าแยกเป็น 2 ทาง เพราะบัญชีกับค่าระบบเป็นคนละเรื่องกัน
            ลิงก์ตรงไปที่กลุ่มนั้นในหน้า /settings เลย ไม่ต้องลงไปหาเอง */}
        <a
          href="/settings#account"
          aria-current={current === 'settings' ? 'page' : undefined}
          class={`${item} text-body hover:bg-field`}
        >
          <svg {...SVG_PROPS} class={itemIco} set:html={ICON.user} />
          {t('set.groupAccount')}
        </a>
        <a
          href="/settings#system"
          aria-current={current === 'settings' ? 'page' : undefined}
          class={`${item} text-body hover:bg-field`}
        >
          <svg {...SVG_PROPS} class={itemIco} set:html={ICON.gear} />
          {t('set.groupSystem')}
        </a>

        <span class={divide}></span>

        <form method="post" action="/logout">
          <button class={`${item} text-accent-ink hover:bg-field`}>
            <svg {...SVG_PROPS} class={itemIco} set:html={ICON.logout} />
            {t('nav.logout')}
          </button>
        </form>
      </div>
    </details>
  </div>
</nav>

{/* กันเนื้อหาไม่ให้มุดใต้แถบที่ fixed — อยู่ในคอมโพเนนต์เองหน้าอื่นจะได้ไม่ต้องจำ */}
<div class="h-14" aria-hidden="true"></div>
