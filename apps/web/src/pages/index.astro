---
import Base from '../layouts/Base.astro';
import { db } from '../lib/db.js';
import { sinceText } from '../lib/since.js';
import { starsText } from '../lib/event.js';
import { imageSize } from '../lib/thumb.js';
import { siteSettings } from '../lib/settings.js';
import Nav from '../components/Nav.astro';
import { LANG_COOKIE, dict, localeOf, validLang } from '../lib/i18n.js';
import { displayName, initialOf } from '../lib/avatar.js';

const { coupleName, startDate } = siteSettings();
const lang = validLang(Astro.cookies.get(LANG_COOKIE)?.value);
const t = dict(lang);
const locale = localeOf(lang);

const events = db
  .prepare('SELECT * FROM event ORDER BY event_date ASC, id ASC')
  .all();

// รูปที่อัปไว้ก่อนมีคอลัมน์นี้ยังไม่รู้สัดส่วน — อ่านครั้งเดียวแล้วเก็บไว้ ครั้งต่อไปไม่ต้องอ่านอีก
const unsized = events.filter((e) => e.image && !e.image_w);
if (unsized.length) {
  const remember = db.prepare('UPDATE event SET image_w = ?, image_h = ? WHERE id = ?');
  for (const e of unsized) {
    const size = await imageSize(e.image);
    if (!size) continue;
    remember.run(size.width, size.height, e.id);
    e.image_w = size.width;
    e.image_h = size.height;
  }
}

// 2 บัญชี — โหลดทีเดียวแล้วเทียบในหน่วยความจำ ดีกว่า JOIN ต่อแถวหรือ query ต่อการ์ด
const authors = new Map(
  db.prepare('SELECT id, name, email FROM user').all().map((u) => [u.id, u]),
);

const long = new Intl.DateTimeFormat(locale, { dateStyle: 'long' });
const medium = new Intl.DateTimeFormat(locale, { dateStyle: 'medium' });
const day = (iso: string) => new Date(`${iso}T00:00:00`);

// render มาจาก server ก่อน แล้ว JS ค่อยเขียนทับให้เดินจริง — JS ตายก็ยังอ่านออก
const elapsed = Date.now() - Date.parse(`${startDate}T00:00:00`);
const days = Math.floor(elapsed / 86400000);
const hours = Math.floor(elapsed / 3600000) % 24;
const minutes = Math.floor(elapsed / 60000) % 60;
const seconds = Math.floor(elapsed / 1000) % 60;

const wrap = 'mx-auto w-full max-w-5xl px-5 sm:px-12';
const stamp = 'font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] sm:text-[11px]';
const heading = 'font-display text-pretty';
// วงเดียวกับ avatar บน navbar แค่เล็กลง — คนเดียวกันต้องหน้าตาเหมือนกันทั้งเว็บ
const avatar =
  'flex size-7 flex-none items-center justify-center rounded-full border border-alt-muted/45 bg-alt-bg text-[11.5px] font-medium text-alt-ink';
---

<Base title={coupleName}>
  <Nav current="timeline" />

  <header class="border-b border-line">
    <div class={`${wrap} pt-11 pb-9 sm:grid sm:grid-cols-[1fr_auto] sm:items-end sm:gap-10 sm:pt-[76px] sm:pb-[60px]`}>
      <div>
        <h1 class={`${heading} max-w-[15ch] text-[34px] leading-[1.4] text-text sm:text-[58px] sm:leading-[1.35]`}>
          {coupleName}
        </h1>
        <p class="mt-3.5 hidden max-w-[46ch] text-[16.5px] leading-[1.9] sm:block">
          {t('app.tagline')}
        </p>
      </div>

      <div class="mt-5 sm:mt-0 sm:pb-1.5 sm:text-right">
        {/* หน่วยเวลาส่งเข้าไปทาง data-* ให้สคริปต์ท้ายหน้า — สคริปต์นั้นจะได้ไม่ต้องรู้จักภาษา */}
        <p
          id="counter"
          data-start={startDate}
          data-locale={locale}
          data-days={t('home.days')}
          data-hours={t('home.hours')}
          data-minutes={t('home.minutes')}
          data-seconds={t('home.seconds')}
          class="font-display text-[28px] leading-[1.4] text-accent-ink tabular-nums sm:text-[52px] sm:leading-[1.3]"
        >
          {days.toLocaleString(locale)} {t('home.days')}
        </p>
        {/* ponytail: render ฝั่ง server อย่างเดียว — บรรทัดนี้เปลี่ยนวันละครั้ง ไม่ต้อง tick
            ceiling: เปิดหน้าค้างข้ามเที่ยงคืนแล้วจะช้าไปหนึ่งวันจนกว่าจะ reload */}
        <p class="mt-0.5 text-[13px] leading-[1.7] sm:text-[15px]">{sinceText(startDate, t)}</p>
        <p id="counter-live" class="font-mono text-[11px] text-muted tabular-nums sm:text-[12px]">
          {hours} {t('home.hours')} {minutes} {t('home.minutes')} {seconds} {t('home.seconds')}
        </p>
        <p class="mt-0.5 text-[12.5px] leading-[1.8] text-muted sm:text-[13.5px]">
          {t('home.since')} {long.format(day(startDate))}
        </p>
      </div>
    </div>
  </header>

  <main class={`${wrap} pt-8 pb-14 sm:pt-12 sm:pb-10`}>

    {
      events.length === 0 ? (
        <div class="rounded-[26px] border-[1.5px] border-dashed border-accent/40 bg-surface px-6 py-9 text-center sm:px-10 sm:py-12">
          <span class="mx-auto mb-5 flex size-13 items-center justify-center rounded-full bg-accent/15">
            <span class="pulse block size-3 rounded-full bg-accent" />
          </span>
          <h2 class={`${heading} text-[24px] leading-[1.5] text-text`}>{t('home.emptyTitle')}</h2>
          <p class="mx-auto mt-2.5 max-w-[34ch] text-[14.5px] leading-[1.9]">
            {t('home.emptyBody')}
          </p>
          <a
            href="/admin"
            class="mt-5 inline-flex min-h-11 items-center rounded-full bg-accent px-6 text-[14.5px] font-medium text-on-accent"
          >
            {t('home.emptyCta')}
          </a>
        </div>
      ) : (
        <div class="relative">
          <div class="absolute top-1.5 bottom-1.5 left-[11px] w-px bg-line sm:left-1/2 sm:-translate-x-1/2" />
          <ol class="relative grid gap-8 pl-7 sm:gap-16 sm:pl-0">
            {events.map((e, i) => (
              /* min-w-0 ทุกใบ = กัน grid item ขยายตาม min-content แล้วดันจอ 375px ให้เลื่อนแนวนอน */
              <li
                id={`e${e.id}`}
                class="reveal relative min-w-0 sm:grid sm:grid-cols-2 sm:gap-x-[72px]"
              >
                <span class="absolute top-6 -left-[23px] block size-3 rounded-full bg-accent ring-[3px] ring-bg sm:top-[26px] sm:left-1/2 sm:size-[13px] sm:-translate-x-1/2" />

                {e.image ? (
                  <article
                    class:list={[
                      'min-w-0 overflow-hidden rounded-[22px] border border-line bg-surface shadow-[0_3px_10px_rgba(133,41,54,0.12)] sm:rounded-[28px]',
                      i % 2 === 0 ? 'sm:col-start-1' : 'sm:col-start-2',
                    ]}
                  >
                    <img
                      src={`/uploads/${e.image}?s=md`}
                      alt={e.title}
                      loading="lazy"
                      decoding="async"
                      onload="this.classList.remove('skeleton')"
                      width={e.image_w ?? undefined}
                      height={e.image_h ?? undefined}
                      class:list={[
                        'skeleton w-full',
                        // ไม่รู้สัดส่วน (sharp ใช้ไม่ได้) ค่อยตกไปใช้กรอบ 4:3 แบบเดิม
                        !e.image_w && 'aspect-[4/3] object-cover',
                      ]}
                    />
                    <div class="px-5 pt-[18px] pb-[22px] sm:px-7 sm:pt-[26px] sm:pb-[30px]">
                      <time datetime={e.event_date} class={`${stamp} block text-muted`}>
                        {medium.format(day(e.event_date))}
                      </time>
                      <h2 class={`${heading} mt-2 text-[21px] leading-[1.5] text-text sm:text-[26px] sm:leading-[1.45]`}>
                        {e.title}
                      </h2>
                      {e.rating && (
                        <p
                          class="mt-2 text-[14px] tracking-[0.12em] text-accent"
                          aria-label={t('home.starsLabel', e.rating)}
                        >
                          <span aria-hidden="true">{starsText(e.rating)}</span>
                        </p>
                      )}
                      {e.description && (
                        <p class="mt-2 text-[14.5px] leading-[1.9] sm:mt-2.5 sm:text-[15px]">{e.description}</p>
                      )}
                      <div class="mt-3 flex items-center gap-3">
                        {e.location && (
                          <p class="flex min-w-0 items-center gap-[7px] text-[12.5px] text-muted sm:text-[13px]">
                            <span class="block size-[5px] flex-none rounded-full bg-alt" />
                            <span class="truncate">{e.location}</span>
                          </p>
                        )}
                        {authors.get(e.author_id) && (
                          <span class={`${avatar} ml-auto`} title={displayName(authors.get(e.author_id))}>
                            <span class="sr-only">{t('home.postedBy', displayName(authors.get(e.author_id)))}</span>
                            <span aria-hidden="true">{initialOf(authors.get(e.author_id))}</span>
                          </span>
                        )}
                      </div>
                    </div>
                  </article>
                ) : e.description ? (
                  /* ไม่มีรูป + มีเรื่องเล่า = "การ์ดคำพูด" พื้นชมพู ตัวใหญ่ขึ้น — ไม่ใช่การ์ดพิการ */
                  <article
                    class:list={[
                      'min-w-0 rounded-[22px] border border-soft-line bg-soft-bg px-[22px] py-6 sm:rounded-[28px] sm:p-[34px]',
                      i % 2 === 0 ? 'sm:col-start-1' : 'sm:col-start-2',
                    ]}
                  >
                    <time datetime={e.event_date} class={`${stamp} block text-soft-muted`}>
                      {medium.format(day(e.event_date))}
                    </time>
                    <h2 class={`${heading} mt-2.5 text-[23px] leading-[1.5] text-soft-ink sm:mt-3.5 sm:text-[30px] sm:leading-[1.45]`}>
                      {e.title}
                    </h2>
                    {e.rating && (
                      <p
                        class="mt-2 text-[14px] tracking-[0.12em] text-accent"
                        aria-label={t('home.starsLabel', e.rating)}
                      >
                        <span aria-hidden="true">{starsText(e.rating)}</span>
                      </p>
                    )}
                    <p class="mt-2 text-[15px] leading-[1.95] text-soft-ink/85 sm:mt-3 sm:text-[17px]">
                      {e.description}
                    </p>
                    <div class="mt-3.5 flex items-center gap-3">
                      {e.location && (
                        <p class="flex min-w-0 items-center gap-[7px] text-[12.5px] text-soft-muted sm:text-[13px]">
                          <span class="block size-[5px] flex-none rounded-full bg-soft" />
                          <span class="truncate">{e.location}</span>
                        </p>
                      )}
                      {authors.get(e.author_id) && (
                        <span class={`${avatar} ml-auto`} title={displayName(authors.get(e.author_id))}>
                          <span class="sr-only">{t('home.postedBy', displayName(authors.get(e.author_id)))}</span>
                          <span aria-hidden="true">{initialOf(authors.get(e.author_id))}</span>
                        </span>
                      )}
                    </div>
                  </article>
                ) : (
                  <article
                    class:list={[
                      'min-w-0 rounded-[22px] border border-line bg-surface px-[22px] py-6 shadow-[0_3px_10px_rgba(133,41,54,0.12)] sm:rounded-[28px] sm:px-8 sm:py-8',
                      i % 2 === 0 ? 'sm:col-start-1' : 'sm:col-start-2',
                    ]}
                  >
                    <time datetime={e.event_date} class={`${stamp} block text-muted`}>
                      {medium.format(day(e.event_date))}
                    </time>
                    <h2 class={`${heading} mt-2.5 text-[21px] leading-[1.5] text-text sm:mt-3 sm:text-[26px] sm:leading-[1.45]`}>
                      {e.title}
                    </h2>
                    {e.rating && (
                      <p
                        class="mt-2 text-[14px] tracking-[0.12em] text-accent"
                        aria-label={t('home.starsLabel', e.rating)}
                      >
                        <span aria-hidden="true">{starsText(e.rating)}</span>
                      </p>
                    )}
                    <div class="mt-3 flex items-center gap-3">
                      {e.location && (
                        <p class="flex min-w-0 items-center gap-[7px] text-[12.5px] text-muted sm:text-[13px]">
                          <span class="block size-[5px] flex-none rounded-full bg-alt" />
                          <span class="truncate">{e.location}</span>
                        </p>
                      )}
                      {authors.get(e.author_id) && (
                        <span class={`${avatar} ml-auto`} title={displayName(authors.get(e.author_id))}>
                          <span class="sr-only">{t('home.postedBy', displayName(authors.get(e.author_id)))}</span>
                          <span aria-hidden="true">{initialOf(authors.get(e.author_id))}</span>
                        </span>
                      )}
                    </div>
                  </article>
                )}
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </main>

  <footer class="border-t border-line">
    <div class={`${wrap} py-8 sm:py-10`}>
      <span class="text-[13px] text-muted">{t('home.footer')}</span>
    </div>
  </footer>

  <script is:inline>
    const counter = document.getElementById('counter');
    const live = document.getElementById('counter-live');
    const u = counter.dataset; // ภาษามาจาก server ทั้งหมด สคริปต์นี้ไม่มีคำไทย/อังกฤษของตัวเอง
    const start = Date.parse(u.start + 'T00:00:00');
    const tick = () => {
      const ms = Date.now() - start;
      const d = Math.floor(ms / 86400000);
      counter.textContent = `${d.toLocaleString(u.locale)} ${u.days}`;
      live.textContent =
        `${Math.floor(ms / 3600000) % 24} ${u.hours} ` +
        `${Math.floor(ms / 60000) % 60} ${u.minutes} ` +
        `${Math.floor(ms / 1000) % 60} ${u.seconds}`;
    };
    tick();
    setInterval(tick, 1000);

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
