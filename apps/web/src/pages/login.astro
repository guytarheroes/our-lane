---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
import { db } from '../lib/db.js';
import { COOKIE, sign, verify } from '../lib/auth.js';
import { reset, tooMany } from '../lib/ratelimit.js';

if (Astro.locals.userId) return Astro.redirect('/');

// ponytail: เว็บของคู่รัก = 2 บัญชี — ลิงก์ไปหน้าสมัครหายไปเองเมื่อครบ
const { n } = db.prepare('SELECT COUNT(*) AS n FROM user').get();
const canRegister = n < 2;

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const ip = Astro.clientAddress || 'unknown';

  if (tooMany(ip)) {
    error = 'ลองผิดหลายครั้งเกินไป รออีก 15 นาทีแล้วค่อยลองใหม่';
  } else if (!email.includes('@') || password.length < 8) {
    error = 'ต้องกรอกอีเมลให้ถูกต้อง และรหัสผ่านอย่างน้อย 8 ตัวอักษร';
  } else {
    const user = db
      .prepare('SELECT id, password, token_version FROM user WHERE email = ?')
      .get(email);
    if (user && verify(password, user.password)) {
      reset(ip);
      Astro.cookies.set('session', sign(user.id, user.token_version), COOKIE);
      return Astro.redirect('/');
    }
    // ข้อความเดียวกันทั้งกรณีไม่มีอีเมลนี้และรหัสผิด — ไม่บอกใบ้ว่าอีเมลไหนมีอยู่จริง
    error = 'อีเมลหรือรหัสผ่านไม่ถูกต้อง';
  }
}

const label = 'grid gap-1.5 text-[13px] leading-[1.8] text-body';
const input =
  'min-h-12 w-full rounded-2xl border border-line bg-field px-4 text-[15px] leading-[1.6] text-text outline-none focus:border-accent';
---

<Base title="เข้าสู่ระบบ · Our Memory Lane">
  <AuthShell title="ยินดีต้อนรับกลับ" subtitle="เข้าสู่ระบบเพื่อดูความทรงจำของเรา">
    {
      error && (
        <p class="mt-6 rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-3 text-[13.5px] text-accent-ink">
          {error}
        </p>
      )
    }

    <form method="post" class="mt-7 grid gap-4">
      <label class={label}>
        อีเมล
        <input
          class={input}
          type="email"
          name="email"
          autocomplete="username"
          inputmode="email"
          required
        />
      </label>
      <label class={label}>
        รหัสผ่าน
        <input
          class={input}
          type="password"
          name="password"
          autocomplete="current-password"
          required
        />
      </label>
      <button class="mt-1 min-h-12 rounded-full bg-accent px-6 text-[15.5px] font-medium text-on-accent">
        เข้าสู่ระบบ
      </button>
      <a href="/forgot" class="justify-self-center text-[13px] text-muted underline underline-offset-4">
        ลืมรหัสผ่าน?
      </a>
    </form>

    {
      canRegister && (
        <p class="mt-7 text-[13.5px] text-muted">
          ยังไม่มีบัญชี?{' '}
          <a href="/register" class="font-medium text-accent-ink underline underline-offset-4">
            สมัครสมาชิก
          </a>{' '}
          (เหลือ {2 - n} ที่)
        </p>
      )
    }
  </AuthShell>
</Base>
