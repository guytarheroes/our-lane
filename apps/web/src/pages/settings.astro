---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { db } from '../lib/db.js';
import { COOKIE, hash, sign, verify } from '../lib/auth.js';
import { reset, tooMany } from '../lib/ratelimit.js';
import { accentColors, clearSetting, setSetting, siteSettings } from '../lib/settings.js';
import { DEFAULT_ACCENT, THEME_BG, accentFits, contrast, validHex } from '../lib/color.js';
import { todayISO, validDate } from '../lib/calendar.js';
import { generateCode, hashCode } from '../lib/recovery.js';
import { THEME_COOKIE, THEME_COOKIE_OPTIONS, isMobileUA, validTheme } from '../lib/theme.js';

const me = Astro.locals.user;
let error = '';
/** รหัสที่เพิ่งสร้าง — โชว์ในหน้าตอบกลับของ POST ครั้งนี้ครั้งเดียว ไม่เก็บที่ไหนอีก */
let freshCode = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = form.get('intent');

  if (intent === 'profile') {
    const name = String(form.get('name') ?? '').trim().slice(0, 60);
    db.prepare('UPDATE user SET name = ? WHERE id = ?').run(name || null, me.id);
    return Astro.redirect('/settings?saved=profile', 303);
  }

  if (intent === 'password') {
    const ip = Astro.clientAddress || 'unknown';
    const current = String(form.get('current') ?? '');
    const next = String(form.get('next') ?? '');
    const confirm = String(form.get('confirm') ?? '');

    // กันเดารหัสเดิมรัว ๆ ด้วยโควตาชุดเดียวกับหน้า login
    if (tooMany(ip)) {
      error = 'ลองผิดหลายครั้งเกินไป รออีก 15 นาทีแล้วค่อยลองใหม่';
    } else if (next.length < 8) {
      error = 'รหัสผ่านใหม่ต้องยาวอย่างน้อย 8 ตัวอักษร';
    } else if (next !== confirm) {
      error = 'รหัสผ่านใหม่กับช่องยืนยันไม่ตรงกัน';
    } else {
      const row = db.prepare('SELECT password FROM user WHERE id = ?').get(me.id);
      if (!row || !verify(current, row.password)) {
        error = 'รหัสผ่านปัจจุบันไม่ถูกต้อง';
      } else {
        // บวก token_version = cookie ทุกใบที่ออกไปก่อนหน้านี้ใช้ไม่ได้ทันที
        const version = me.token_version + 1;
        db.prepare('UPDATE user SET password = ?, token_version = ? WHERE id = ?').run(
          hash(next),
          version,
          me.id,
        );
        // เซ็น cookie ใหม่ให้เครื่องนี้ ไม่งั้นคนที่เพิ่งเปลี่ยนรหัสจะโดนเตะออกเองด้วย
        Astro.cookies.set('session', sign(me.id, version), COOKIE);
        reset(ip);
        return Astro.redirect('/settings?saved=password', 303);
      }
    }
  }

  if (intent === 'theme') {
    Astro.cookies.set(THEME_COOKIE, validTheme(form.get('theme')), THEME_COOKIE_OPTIONS);
    return Astro.redirect('/settings?saved=theme', 303);
  }

  if (intent === 'colors_reset') {
    clearSetting('accent_light');
    clearSetting('accent_dark');
    return Astro.redirect('/settings?saved=colors', 303);
  }

  if (intent === 'colors') {
    const light = validHex(form.get('accent_light'));
    const dark = validHex(form.get('accent_dark'));

    const okLight = light && accentFits(light, 'light');
    const okDark = dark && accentFits(dark, 'dark');

    if (!light || !dark) {
      error = 'สีไม่ถูกต้อง';
    } else if (!okLight.ok) {
      error = `สีของโหมดสว่าง${okLight.reason}`;
    } else if (!okDark.ok) {
      error = `สีของโหมดมืด${okDark.reason}`;
    } else {
      setSetting('accent_light', light);
      setSetting('accent_dark', dark);
      return Astro.redirect('/settings?saved=colors', 303);
    }
  }

  if (intent === 'recovery') {
    freshCode = generateCode();
    // เก็บเป็น hash เหมือนรหัสผ่าน — สร้างใหม่ทับของเดิม อันเก่าใช้ไม่ได้ทันที
    db.prepare('UPDATE user SET recovery = ? WHERE id = ?').run(hashCode(freshCode), me.id);
  }

  if (intent === 'site') {
    const coupleName = String(form.get('couple_name') ?? '').trim().slice(0, 80);
    const startDate = validDate(form.get('start_date'));

    if (!coupleName) {
      error = 'ชื่อบนหน้าแรกว่างไม่ได้';
    } else if (!startDate) {
      error = 'วันเริ่มนับไม่ถูกต้อง';
    } else if (startDate > todayISO()) {
      error = 'วันเริ่มนับอยู่ในอนาคตไม่ได้';
    } else {
      setSetting('couple_name', coupleName);
      setSetting('start_date', startDate);
      return Astro.redirect('/settings?saved=site', 303);
    }
  }
}

const saved = Astro.url.searchParams.get('saved');
const savedMessage = {
  profile: 'บันทึกชื่อแล้ว',
  password: 'เปลี่ยนรหัสผ่านแล้ว — อุปกรณ์อื่นถูกให้ออกจากระบบทั้งหมด',
  site: 'บันทึกค่าเว็บแล้ว',
  theme: 'เปลี่ยนธีมแล้ว',
  colors: 'บันทึกสีแล้ว',
  recovered: 'ตั้งรหัสผ่านใหม่แล้ว — รหัสกู้คืนอันเดิมถูกใช้ไปแล้ว สร้างอันใหม่เก็บไว้ด้วย',
}[saved ?? ''];

const site = siteSettings();
const theme = validTheme(Astro.cookies.get(THEME_COOKIE)?.value);
const onMobile = isMobileUA(Astro.request.headers.get('user-agent'));
const accent = accentColors() ?? DEFAULT_ACCENT;

// ไอคอนวาดเอง ไม่ใช้ icon library ตามกฎห้ามเพิ่ม dependency — 24x24 stroke ตาม currentColor
const ICONS = {
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.6h2"/>',
  monitor: '<rect x="2.5" y="4" width="19" height="12.5" rx="2"/><path d="M8.5 20.5h7M12 16.5v4"/>',
  light:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2.4M12 19.6V22M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M2 12h2.4M19.6 12H22M4.6 19.4l1.7-1.7M17.7 6.3l1.7-1.7"/>',
  dark: '<path d="M20.2 14.8A8.6 8.6 0 0 1 9.2 3.8a8.6 8.6 0 1 0 11 11z"/>',
};

const themeOptions = [
  { value: 'system', label: 'ตามเครื่อง', icon: onMobile ? ICONS.phone : ICONS.monitor },
  { value: 'light', label: 'สว่าง', icon: ICONS.light },
  { value: 'dark', label: 'มืด', icon: ICONS.dark },
];
const hasRecovery = Boolean(
  db.prepare('SELECT recovery FROM user WHERE id = ?').get(me.id)?.recovery,
);

const card =
  'grid gap-3.5 rounded-[24px] border border-line bg-surface p-5 shadow-[0_3px_10px_rgba(46,43,37,0.10)] sm:rounded-[26px] sm:p-[26px]';
const label = 'grid gap-1.5 text-[12.5px] leading-[1.8]';
const input =
  'min-h-11 w-full rounded-[14px] border border-line bg-field px-3.5 py-2.5 text-[15px] leading-[1.6] text-text outline-none focus:border-accent';
const submit = 'min-h-11 justify-self-start rounded-full bg-accent px-6 text-[14.5px] font-medium text-on-accent';
const heading = 'font-display text-[17px] leading-[1.5] text-text';
---

<Base title="ตั้งค่า">
  <Nav current="settings" />

  <main class="mx-auto w-full max-w-2xl px-5 py-7 sm:px-9 sm:py-9">
    <h1 class="mt-6 mb-4 font-display text-[22px] leading-[1.45] text-text sm:text-[24px]">ตั้งค่า</h1>

    {
      savedMessage && (
        <p class="mb-4 rounded-2xl border border-alt-line bg-alt-bg px-4 py-3 text-[13.5px] text-alt-ink">
          {savedMessage}
        </p>
      )
    }
    {
      error && (
        <p class="mb-4 rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-3 text-[13.5px] text-accent-ink">
          {error}
        </p>
      )
    }

    <div class="grid gap-5">
      <form method="post" class={card}>
        <input type="hidden" name="intent" value="theme" />
        <h2 class={heading}>ธีม</h2>
        <p class="text-[12.5px] leading-[1.8] text-muted">
          จำไว้ในเบราว์เซอร์นี้ — เปลี่ยนเครื่องต้องเลือกใหม่
        </p>
        {/* ปุ่มแต่ละอันส่งค่าของตัวเองผ่าน name/value ของ <button> กดทีเดียวจบ
            ไม่ต้องมีปุ่มบันทึกแยก และไม่ต้องใช้ JS สักบรรทัด */}
        <div class="flex gap-1.5 rounded-full border border-line bg-field p-1">
          {
            themeOptions.map((opt) => (
              <button
                name="theme"
                value={opt.value}
                aria-current={theme === opt.value ? 'true' : undefined}
                class:list={[
                  'flex min-h-9 flex-1 items-center justify-center gap-1.5 rounded-full text-[13px] font-medium',
                  theme === opt.value ? 'bg-accent text-on-accent' : 'text-muted hover:bg-surface',
                ]}
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 flex-none"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={opt.icon}
                />
                {opt.label}
              </button>
            ))
          }
        </div>
      </form>

      <form method="post" class={card}>
        <input type="hidden" name="intent" value="colors" />
        <h2 class={heading}>สีหลัก</h2>
        <p class="text-[12.5px] leading-[1.8] text-muted">
          ใช้กับปุ่ม ลิงก์ หัวข้อ และจุดบนไทม์ไลน์ — ตั้งครั้งเดียวเห็นทั้งสองคน
          <br />
          ต้องเข้ม/สว่างพอที่จะอ่านออกบนพื้นของแต่ละโหมด ถ้าไม่ผ่านระบบจะบอกเหตุผล
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class={label}>
            โหมดสว่าง
            <span class="flex items-center gap-2.5">
              <input
                type="color"
                name="accent_light"
                value={accent.light}
                class="h-11 w-14 flex-none cursor-pointer rounded-xl border border-line bg-field p-1"
              />
              <span class="font-mono text-[12px] text-muted">
                {accent.light} · {contrast(accent.light, THEME_BG.light).toFixed(1)}:1
              </span>
            </span>
          </label>
          <label class={label}>
            โหมดมืด
            <span class="flex items-center gap-2.5">
              <input
                type="color"
                name="accent_dark"
                value={accent.dark}
                class="h-11 w-14 flex-none cursor-pointer rounded-xl border border-line bg-field p-1"
              />
              <span class="font-mono text-[12px] text-muted">
                {accent.dark} · {contrast(accent.dark, THEME_BG.dark).toFixed(1)}:1
              </span>
            </span>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <button class={submit}>บันทึกสี</button>
          <button
            name="intent"
            value="colors_reset"
            class="text-[13px] text-muted underline underline-offset-4"
          >
            กลับไปใช้สีตั้งต้น
          </button>
        </div>
      </form>

      <form method="post" class={card}>
        <input type="hidden" name="intent" value="profile" />
        <h2 class={heading}>บัญชี</h2>
        <p class="text-[12.5px] text-muted">
          อีเมล <span class="font-mono text-body">{me?.email}</span> — เปลี่ยนไม่ได้
        </p>
        <label class={label}>
          ชื่อ <span class="text-muted">(ใช้เป็นตัวย่อบนไอคอนมุมขวาบน)</span>
          <input class={input} type="text" name="name" value={me?.name ?? ''} maxlength="60" />
        </label>
        <button class={submit}>บันทึกชื่อ</button>
      </form>

      <form method="post" class={card}>
        <input type="hidden" name="intent" value="password" />
        <h2 class={heading}>เปลี่ยนรหัสผ่าน</h2>
        <p class="text-[12.5px] leading-[1.8] text-muted">
          เปลี่ยนแล้วอุปกรณ์อื่นที่ค้างล็อกอินอยู่จะถูกให้ออกจากระบบทั้งหมด เครื่องนี้ยังอยู่ต่อ
        </p>
        <label class={label}>
          รหัสผ่านปัจจุบัน
          <input class={input} type="password" name="current" autocomplete="current-password" required />
        </label>
        <label class={label}>
          รหัสผ่านใหม่ <span class="text-muted">(อย่างน้อย 8 ตัว)</span>
          <input
            class={input}
            type="password"
            name="next"
            minlength="8"
            autocomplete="new-password"
            required
          />
        </label>
        <label class={label}>
          ยืนยันรหัสผ่านใหม่
          <input
            class={input}
            type="password"
            name="confirm"
            minlength="8"
            autocomplete="new-password"
            required
          />
        </label>
        <button class={submit}>เปลี่ยนรหัสผ่าน</button>
      </form>

      <form method="post" class={card}>
        <input type="hidden" name="intent" value="recovery" />
        <h2 class={heading}>รหัสกู้คืน</h2>
        {
          freshCode ? (
            <>
              <p class="text-[12.5px] leading-[1.8] text-accent-ink">
                จดเก็บไว้ตอนนี้เลย — ปิดหน้านี้แล้วจะดูอีกไม่ได้ ถ้าหายต้องสร้างใหม่
              </p>
              <p class="rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-4 text-center font-mono text-[18px] tracking-[0.12em] text-accent-ink select-all">
                {freshCode}
              </p>
            </>
          ) : (
            <p class="text-[12.5px] leading-[1.8] text-muted">
              {hasRecovery
                ? 'มีรหัสกู้คืนอยู่แล้ว ถ้าจำไม่ได้ว่าเก็บไว้ไหน สร้างใหม่ได้ — อันเก่าจะใช้ไม่ได้ทันที'
                : 'ยังไม่มีรหัสกู้คืน ถ้าลืมรหัสผ่านตอนนี้จะเข้าเว็บไม่ได้เลย ต้องไปกู้จากเครื่องเซิร์ฟเวอร์'}
            </p>
          )
        }
        <button class={submit}>{hasRecovery || freshCode ? 'สร้างรหัสกู้คืนใหม่' : 'สร้างรหัสกู้คืน'}</button>
      </form>

      <form method="post" class={card}>
        <input type="hidden" name="intent" value="site" />
        <h2 class={heading}>ค่าเว็บ</h2>
        <label class={label}>
          ชื่อบนหน้าแรก
          <input
            class={input}
            type="text"
            name="couple_name"
            value={site.coupleName}
            maxlength="80"
            required
          />
        </label>
        <label class={label}>
          วันเริ่มนับ <span class="text-muted">(ตัวนับวันบนหน้าแรกนับจากวันนี้)</span>
          <input class={input} type="date" name="start_date" value={site.startDate} required />
        </label>
        <button class={submit}>บันทึกค่าเว็บ</button>
      </form>
    </div>
  </main>
</Base>
