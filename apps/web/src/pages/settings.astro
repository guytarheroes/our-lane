---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { db } from '../lib/db.js';
import { COOKIE, hash, sign, verify } from '../lib/auth.js';
import { reset, tooMany } from '../lib/ratelimit.js';
import { setSetting, siteSettings } from '../lib/settings.js';
import { todayISO, validDate } from '../lib/calendar.js';
import { generateCode, hashCode } from '../lib/recovery.js';
import { THEME_COOKIE, THEME_COOKIE_OPTIONS, validTheme } from '../lib/theme.js';
import { LANG_COOKIE, LANG_COOKIE_OPTIONS, dict, validLang } from '../lib/i18n.js';
import { ICON, SVG_PROPS } from '../lib/icons.js';

const me = Astro.locals.user;
// อ่านภาษาก่อน POST — เปลี่ยนภาษาแล้ว redirect หน้าถัดไปจะได้ภาษาใหม่จาก cookie ที่เพิ่งเซ็ต
const t = dict(validLang(Astro.cookies.get(LANG_COOKIE)?.value));
let error = '';
/** รหัสที่เพิ่งสร้าง — โชว์ในหน้าตอบกลับของ POST ครั้งนี้ครั้งเดียว ไม่เก็บที่ไหนอีก */
let freshCode = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = form.get('intent');

  if (intent === 'profile') {
    const name = String(form.get('name') ?? '').trim().slice(0, 60);
    db.prepare('UPDATE user SET name = ? WHERE id = ?').run(name || null, me.id);
    return Astro.redirect('/settings?saved=profile', 303);
  }

  if (intent === 'password') {
    const ip = Astro.clientAddress || 'unknown';
    const current = String(form.get('current') ?? '');
    const next = String(form.get('next') ?? '');
    const confirm = String(form.get('confirm') ?? '');

    // กันเดารหัสเดิมรัว ๆ ด้วยโควตาชุดเดียวกับหน้า login
    if (tooMany(ip)) {
      error = t('err.rateLimit');
    } else if (next.length < 8) {
      error = t('err.passwordShort');
    } else if (next !== confirm) {
      error = t('err.passwordMismatch');
    } else {
      const row = db.prepare('SELECT password FROM user WHERE id = ?').get(me.id);
      if (!row || !verify(current, row.password)) {
        error = t('err.passwordWrong');
      } else {
        // บวก token_version = cookie ทุกใบที่ออกไปก่อนหน้านี้ใช้ไม่ได้ทันที
        const version = me.token_version + 1;
        db.prepare('UPDATE user SET password = ?, token_version = ? WHERE id = ?').run(
          hash(next),
          version,
          me.id,
        );
        // เซ็น cookie ใหม่ให้เครื่องนี้ ไม่งั้นคนที่เพิ่งเปลี่ยนรหัสจะโดนเตะออกเองด้วย
        Astro.cookies.set('session', sign(me.id, version), COOKIE);
        reset(ip);
        return Astro.redirect('/settings?saved=password', 303);
      }
    }
  }

  if (intent === 'lang') {
    Astro.cookies.set(LANG_COOKIE, validLang(form.get('lang')), LANG_COOKIE_OPTIONS);
    return Astro.redirect('/settings?saved=lang', 303);
  }

  if (intent === 'theme') {
    Astro.cookies.set(THEME_COOKIE, validTheme(form.get('theme')), THEME_COOKIE_OPTIONS);
    return Astro.redirect('/settings?saved=theme', 303);
  }

  if (intent === 'recovery') {
    freshCode = generateCode();
    // เก็บเป็น hash เหมือนรหัสผ่าน — สร้างใหม่ทับของเดิม อันเก่าใช้ไม่ได้ทันที
    db.prepare('UPDATE user SET recovery = ? WHERE id = ?').run(hashCode(freshCode), me.id);
  }

  if (intent === 'site') {
    const coupleName = String(form.get('couple_name') ?? '').trim().slice(0, 80);
    const startDate = validDate(form.get('start_date'));

    if (!coupleName) {
      error = t('err.nameEmpty');
    } else if (!startDate) {
      error = t('err.badStartDate');
    } else if (startDate > todayISO()) {
      error = t('err.futureStartDate');
    } else {
      setSetting('couple_name', coupleName);
      setSetting('start_date', startDate);
      return Astro.redirect('/settings?saved=site', 303);
    }
  }
}

const saved = Astro.url.searchParams.get('saved');
// allowlist ไม่ใช่ t(`saved.${saved}`) เปล่า ๆ — ไม่งั้น ?saved=อะไรก็ได้ จะสะท้อนกลับมาบนหน้า
const savedMessage = ['profile', 'password', 'site', 'theme', 'lang', 'recovered'].includes(saved ?? '')
  ? t(`saved.${saved}`)
  : '';

const site = siteSettings();
const theme = validTheme(Astro.cookies.get(THEME_COOKIE)?.value);
const lang = validLang(Astro.cookies.get(LANG_COOKIE)?.value);

const themeOptions = [
  { value: 'normal', label: t('set.themeNormal'), icon: '<circle cx="12" cy="12" r="8.5"/>' },
  { value: 'invert', label: t('set.themeInvert'), icon: ICON.contrast },
];
const hasRecovery = Boolean(
  db.prepare('SELECT recovery FROM user WHERE id = ?').get(me.id)?.recovery,
);

const card =
  'grid gap-3.5 rounded-[24px] border border-line bg-surface p-5 shadow-[0_3px_10px_rgba(133,41,54,0.12)] sm:rounded-[26px] sm:p-[26px]';
const label = 'grid gap-1.5 text-[12.5px] leading-[1.8]';
const input =
  'min-h-11 w-full rounded-[14px] border border-line bg-field px-3.5 py-2.5 text-[15px] leading-[1.6] text-text outline-none focus:border-accent';
const submit = 'min-h-11 justify-self-start rounded-full bg-accent px-6 text-[14.5px] font-medium text-on-accent';
const heading = 'flex items-center gap-2 font-display text-[17px] leading-[1.5] text-text';
const ico = 'size-[18px] flex-none text-accent-ink';
// หัวข้อกลุ่มเป็น eyebrow แบบเดียวกับ stamp วันที่ในหน้าไทม์ไลน์ — จางกว่าหัวข้อการ์ดตั้งใจ
// ให้มันอ่านเป็นเส้นแบ่ง ไม่ใช่หัวข้อที่แข่งกับชื่อการ์ด
const railIco = 'size-4 flex-none text-muted';
const rail = 'font-mono text-[11px] font-medium tracking-[0.12em] text-muted uppercase';
---

<Base title={t('set.title')}>
  <Nav current="settings" />

  <main class="mx-auto w-full max-w-2xl px-5 py-7 sm:px-9 sm:py-9">
    <h1 class="mt-6 mb-4 font-display text-[22px] leading-[1.45] text-text sm:text-[24px]">{t('set.title')}</h1>

    {
      savedMessage && (
        <p class="mb-4 rounded-2xl border border-alt-line bg-alt-bg px-4 py-3 text-[13.5px] text-alt-ink">
          {savedMessage}
        </p>
      )
    }
    {
      error && (
        <p class="mb-4 rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-3 text-[13.5px] text-accent-ink">
          {error}
        </p>
      )
    }

    <section id="account" class="mt-7 scroll-mt-20 first:mt-0">
      <div class="mb-3.5 flex items-center gap-2.5">
        <svg {...SVG_PROPS} class={railIco} set:html={ICON.user} />
        <h2 class={rail}>{t('set.groupAccount')}</h2>
        <span class="h-px flex-1 bg-line"></span>
      </div>
      <p class="mb-3.5 text-[12px] leading-[1.7] text-muted">{t('set.groupAccountNote')}</p>

      <div class="grid gap-4">
        <form method="post" class={card}>
          <input type="hidden" name="intent" value="profile" />
          <h3 class={heading}>
            <svg {...SVG_PROPS} class={ico} set:html={ICON.user} />{t('set.profile')}</h3>
          <p class="text-[12.5px] text-muted">
            {t('set.email')} <span class="font-mono text-body">{me?.email}</span> — {t('set.emailFixed')}
          </p>
          <label class={label}>
            {t('set.name')} <span class="text-muted">{t('set.nameNote')}</span>
            <input class={input} type="text" name="name" value={me?.name ?? ''} maxlength="60" />
          </label>
          <button class={submit}>{t('set.saveName')}</button>
        </form>

        <form method="post" class={card}>
          <input type="hidden" name="intent" value="password" />
          <h3 class={heading}>
            <svg {...SVG_PROPS} class={ico} set:html={ICON.lock} />{t('set.password')}</h3>
          <p class="text-[12.5px] leading-[1.8] text-muted">
            {t('set.passwordNote')}
          </p>
          <label class={label}>
            {t('set.current')}
            <input class={input} type="password" name="current" autocomplete="current-password" required />
          </label>
          <label class={label}>
            {t('set.next')} <span class="text-muted">{t('set.minLen')}</span>
            <input
              class={input}
              type="password"
              name="next"
              minlength="8"
              autocomplete="new-password"
              required
            />
          </label>
          <label class={label}>
            {t('set.confirm')}
            <input
              class={input}
              type="password"
              name="confirm"
              minlength="8"
              autocomplete="new-password"
              required
            />
          </label>
          <button class={submit}>{t('set.password')}</button>
        </form>

        <form method="post" class={card}>
          <input type="hidden" name="intent" value="recovery" />
          <h3 class={heading}>
            <svg {...SVG_PROPS} class={ico} set:html={ICON.key} />{t('set.recovery')}</h3>
          {
            freshCode ? (
              <>
                <p class="text-[12.5px] leading-[1.8] text-accent-ink">
                  {t('set.recoveryFresh')}
                </p>
                <p class="rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-4 text-center font-mono text-[18px] tracking-[0.12em] text-accent-ink select-all">
                  {freshCode}
                </p>
              </>
            ) : (
              <p class="text-[12.5px] leading-[1.8] text-muted">
                {hasRecovery ? t('set.recoveryHas') : t('set.recoveryNone')}
              </p>
            )
          }
          <button class={submit}>{hasRecovery || freshCode ? t('set.recoveryNew') : t('set.recoveryCreate')}</button>
        </form>
      </div>
    </section>

    <section id="system" class="mt-7 scroll-mt-20 first:mt-0">
      <div class="mb-3.5 flex items-center gap-2.5">
        <svg {...SVG_PROPS} class={railIco} set:html={ICON.gear} />
        <h2 class={rail}>{t('set.groupSystem')}</h2>
        <span class="h-px flex-1 bg-line"></span>
      </div>
      <p class="mb-3.5 text-[12px] leading-[1.7] text-muted">{t('set.groupSystemNote')}</p>

      <div class="grid gap-4">
        <form method="post" class={card}>
          <input type="hidden" name="intent" value="lang" />
          <h3 class={heading}>
            <svg {...SVG_PROPS} class={ico} set:html={ICON.globe} />{t('set.lang')}</h3>
          <div class="flex gap-1.5 rounded-full border border-line bg-field p-1">
            {
              [
                { value: 'th', label: 'ไทย' },
                { value: 'en', label: 'English' },
              ].map((opt) => (
                <button
                  name="lang"
                  value={opt.value}
                  aria-current={lang === opt.value ? 'true' : undefined}
                  class:list={[
                    'min-h-9 flex-1 rounded-full text-[13px] font-medium',
                    lang === opt.value ? 'bg-accent text-on-accent' : 'text-muted hover:bg-surface',
                  ]}
                >
                  {opt.label}
                </button>
              ))
            }
          </div>
        </form>

        <form method="post" class={card}>
          <input type="hidden" name="intent" value="theme" />
          <h3 class={heading}>
            <svg {...SVG_PROPS} class={ico} set:html={ICON.contrast} />{t('set.theme')}</h3>
          <p class="text-[12.5px] leading-[1.8] text-muted">{t('set.themeNote')}</p>
          {/* ปุ่มแต่ละอันส่งค่าของตัวเองผ่าน name/value ของ <button> กดทีเดียวจบ
              ไม่ต้องมีปุ่มบันทึกแยก และไม่ต้องใช้ JS สักบรรทัด */}
          <div class="flex gap-1.5 rounded-full border border-line bg-field p-1">
            {
              themeOptions.map((opt) => (
                <button
                  name="theme"
                  value={opt.value}
                  aria-current={theme === opt.value ? 'true' : undefined}
                  class:list={[
                    'flex min-h-9 flex-1 items-center justify-center gap-1.5 rounded-full text-[13px] font-medium',
                    theme === opt.value ? 'bg-accent text-on-accent' : 'text-muted hover:bg-surface',
                  ]}
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-4 flex-none"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={opt.icon}
                  />
                  {opt.label}
                </button>
              ))
            }
          </div>
        </form>

        <form method="post" class={card}>
          <input type="hidden" name="intent" value="site" />
          <h3 class={heading}>
            <svg {...SVG_PROPS} class={ico} set:html={ICON.sliders} />{t('set.site')}</h3>
          <label class={label}>
            {t('set.siteName')}
            <input
              class={input}
              type="text"
              name="couple_name"
              value={site.coupleName}
              maxlength="80"
              required
            />
          </label>
          <label class={label}>
            {t('set.startDate')} <span class="text-muted">{t('set.startDateNote')}</span>
            <input class={input} type="date" name="start_date" value={site.startDate} required />
          </label>
          <button class={submit}>{t('set.saveSite')}</button>
        </form>
      </div>
    </section>

  </main>
</Base>
