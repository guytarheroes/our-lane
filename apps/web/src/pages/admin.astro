---
import Base from '../layouts/Base.astro';
import { db, UPLOAD_DIR } from '../lib/db.js';
import { removeImage, saveImage } from '../lib/upload.js';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id')) || null;

  if (form.get('intent') === 'delete') {
    const old = id && db.prepare('SELECT image FROM event WHERE id = ?').get(id);
    if (old) {
      db.prepare('DELETE FROM event WHERE id = ?').run(id);
      await removeImage(old.image, UPLOAD_DIR);
    }
    return Astro.redirect('/admin', 303);
  }

  const title = String(form.get('title') ?? '').trim();
  const eventDate = String(form.get('event_date') ?? '');
  const description = String(form.get('description') ?? '').trim();
  const location = String(form.get('location') ?? '').trim() || null;

  if (!title || !/^\d{4}-\d{2}-\d{2}$/.test(eventDate)) {
    error = 'ต้องมีหัวข้อและวันที่';
  } else {
    try {
      const image = await saveImage(form.get('image'), UPLOAD_DIR);
      if (id) {
        const old = db.prepare('SELECT image FROM event WHERE id = ?').get(id);
        db.prepare(
          'UPDATE event SET title = ?, description = ?, event_date = ?, location = ?, image = COALESCE(?, image) WHERE id = ?',
        ).run(title, description, eventDate, location, image, id);
        if (image) await removeImage(old?.image, UPLOAD_DIR);
      } else {
        db.prepare(
          'INSERT INTO event (title, description, event_date, location, image) VALUES (?, ?, ?, ?, ?)',
        ).run(title, description, eventDate, location, image);
      }
      return Astro.redirect('/admin', 303);
    } catch (e) {
      error = e instanceof Error ? e.message : 'บันทึกไม่สำเร็จ';
    }
  }
}

const editId = Number(Astro.url.searchParams.get('edit')) || null;
const editing = editId ? db.prepare('SELECT * FROM event WHERE id = ?').get(editId) : null;
const events = db.prepare('SELECT * FROM event ORDER BY event_date DESC, id DESC').all();

const label = 'grid gap-1.5 text-[12.5px] leading-[1.8]';
const input =
  'min-h-11 w-full rounded-[14px] border border-line bg-field px-3.5 py-2.5 text-[15px] leading-[1.6] text-text outline-none focus:border-accent';
const pill =
  'inline-flex min-h-9 flex-none items-center rounded-full border px-3.5 text-[12.5px] font-medium whitespace-nowrap';
const hatch =
  'bg-[repeating-linear-gradient(135deg,var(--line)_0_8px,var(--field)_8px_16px)]';
---

<Base title={editing ? 'แก้ความทรงจำ' : 'เพิ่มความทรงจำ'}>
  <main class="mx-auto w-full max-w-2xl px-5 py-7 sm:px-9 sm:py-9">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h1 class="min-w-0 font-display text-[22px] leading-[1.45] text-text sm:text-[24px]">
        {editing ? 'แก้ความทรงจำ' : 'เพิ่มความทรงจำ'}
      </h1>
      <div class="flex items-center gap-2.5">
        <a href="/" class={`${pill} border-line text-muted`}>ดู Timeline</a>
        <form method="post" action="/logout">
          <button class={`${pill} border-line text-muted`}>ออกจากระบบ</button>
        </form>
      </div>
    </div>

    {
      error && (
        <p class="mb-4 rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-3 text-[13.5px] text-accent-ink">
          {error}
        </p>
      )
    }

    <form
      method="post"
      enctype="multipart/form-data"
      class="grid gap-3.5 rounded-[24px] border border-line bg-surface p-5 shadow-[0_3px_10px_rgba(46,43,37,0.10)] sm:gap-4 sm:rounded-[26px] sm:p-[26px]"
    >
      {editing && <input type="hidden" name="id" value={editing.id} />}

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-[180px_1fr] sm:gap-3.5">
        <label class={label}>
          วันที่
          <input class={input} type="date" name="event_date" value={editing?.event_date} required />
        </label>
        <label class={label}>
          สถานที่
          <input
            class={input}
            type="text"
            name="location"
            value={editing?.location ?? ''}
            placeholder="ไม่ใส่ก็ได้"
          />
        </label>
      </div>

      <label class={label}>
        หัวข้อ
        <input
          class={input}
          type="text"
          name="title"
          value={editing?.title ?? ''}
          placeholder="วันนี้เกิดอะไรขึ้น"
          required
        />
      </label>

      <label class={label}>
        เล่าให้ฟัง
        <textarea
          class={`${input} min-h-0 resize-y rounded-2xl leading-[1.9]`}
          name="description"
          rows="4"
          placeholder="ไม่ใส่ก็ได้">{editing?.description ?? ''}</textarea>
      </label>

      <label class="grid gap-2 text-[12.5px] leading-[1.8]">
        รูป
        <span
          class:list={[
            'flex items-center gap-3.5 rounded-2xl p-3.5',
            editing ? 'border border-line bg-field' : 'border-[1.5px] border-dashed border-accent/40 bg-field',
          ]}
        >
          {
            editing?.image ? (
              <img
                src={`/uploads/${editing.image}`}
                alt=""
                class="size-14 flex-none rounded-xl object-cover sm:h-[62px] sm:w-[82px]"
              />
            ) : (
              <span class={`block size-11 flex-none rounded-xl ${hatch}`} />
            )
          }
          <span class="flex-1 text-muted">
            {editing ? 'ไม่เลือกไฟล์ใหม่ = เก็บรูปเดิมไว้' : 'jpg · png · webp · gif ไม่เกิน 8MB'}
            <input
              class="mt-1.5 block w-full text-[12.5px] text-muted file:mr-2.5 file:rounded-full file:border-0 file:bg-accent file:px-3 file:py-1.5 file:text-[12px] file:font-medium file:text-bg"
              type="file"
              name="image"
              accept="image/jpeg,image/png,image/webp,image/gif"
            />
          </span>
        </span>
      </label>

      <div class="flex items-center justify-end gap-4">
        {
          editing && (
            <a href="/admin" class="text-[13px] text-accent-ink underline underline-offset-4">
              ยกเลิก
            </a>
          )
        }
        <button
          class="min-h-12 flex-1 rounded-full bg-accent px-6 text-[15.5px] font-medium text-bg sm:min-h-11 sm:flex-none"
        >
          {editing ? 'บันทึกการแก้ไข' : 'บันทึก'}
        </button>
      </div>
    </form>

    {
      events.length > 0 && (
        <>
          <h2 class="mt-8 mb-3 font-display text-[18px] leading-[1.5] text-text">
            ที่บันทึกไว้ {events.length} รายการ
          </h2>
          <ul class="grid gap-2.5">
            {events.map((e) => (
              <li
                class:list={[
                  'flex min-w-0 items-center gap-2.5 rounded-[18px] border p-3 sm:gap-3',
                  e.image ? 'border-line bg-surface' : 'border-sage-line bg-sage-bg',
                ]}
              >
                {e.image ? (
                  <img
                    src={`/uploads/${e.image}`}
                    alt=""
                    loading="lazy"
                    class="size-12 flex-none rounded-xl object-cover"
                  />
                ) : (
                  <span class="flex size-12 flex-none items-center justify-center rounded-xl bg-sage/25 font-mono text-[9.5px] text-sage-muted">
                    no img
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span
                    class:list={[
                      'block truncate text-[14.5px] leading-[1.6]',
                      e.image ? 'text-text' : 'text-sage-ink',
                    ]}
                  >
                    {e.title}
                  </span>
                  <span
                    class:list={[
                      'block font-mono text-[10.5px] leading-[1.7]',
                      e.image ? 'text-muted' : 'text-sage-muted',
                    ]}
                  >
                    {e.event_date}
                  </span>
                </span>
                <a
                  href={`/admin?edit=${e.id}`}
                  class:list={[
                    pill,
                    e.image ? 'border-accent-ink/35 text-accent-ink' : 'border-sage-muted/35 text-sage-muted',
                  ]}
                >
                  แก้
                </a>
                <form method="post" onsubmit="return confirm('ลบความทรงจำนี้?')">
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="id" value={e.id} />
                  <button class={`${pill} border-accent-ink/30 text-accent-ink`}>ลบ</button>
                </form>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </main>
</Base>
