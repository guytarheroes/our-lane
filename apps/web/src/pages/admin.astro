---
import Base from '../layouts/Base.astro';
import { db, UPLOAD_DIR } from '../lib/db.js';
import { removeImage, saveImage } from '../lib/upload.js';
import { imageSize, removeThumbs } from '../lib/thumb.js';
import { parseRating } from '../lib/event.js';
import { todayISO, validDate } from '../lib/calendar.js';
import Nav from '../components/Nav.astro';
import { LANG_COOKIE, dict, validLang } from '../lib/i18n.js';

const t = dict(validLang(Astro.cookies.get(LANG_COOKIE)?.value));

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id')) || null;

  if (form.get('intent') === 'delete') {
    const old = id && db.prepare('SELECT image FROM event WHERE id = ?').get(id);
    if (old) {
      db.prepare('DELETE FROM event WHERE id = ?').run(id);
      await removeImage(old.image, UPLOAD_DIR);
      await removeThumbs(old.image);
    }
    return Astro.redirect('/admin', 303);
  }

  const title = String(form.get('title') ?? '').trim();
  const eventDate = String(form.get('event_date') ?? '');
  const description = String(form.get('description') ?? '').trim();
  const location = String(form.get('location') ?? '').trim() || null;
  const rating = parseRating(form.get('rating'));

  if (!title || !validDate(eventDate)) {
    error = t('err.required');
  } else {
    try {
      const image = await saveImage(form.get('image'), UPLOAD_DIR);
      const size = image ? await imageSize(image) : null;
      if (id) {
        const old = db.prepare('SELECT image FROM event WHERE id = ?').get(id);
        // COALESCE ทุกคอลัมน์ที่เกี่ยวกับรูป — แก้หัวข้อโดยไม่แนบรูปใหม่แล้วรูปกับสัดส่วนเดิมต้องไม่หาย
        db.prepare(
          `UPDATE event
              SET title = ?, description = ?, event_date = ?, location = ?, rating = ?,
                  image = COALESCE(?, image),
                  image_w = COALESCE(?, image_w),
                  image_h = COALESCE(?, image_h)
            WHERE id = ?`,
        ).run(
          title,
          description,
          eventDate,
          location,
          rating,
          image,
          size?.width ?? null,
          size?.height ?? null,
          id,
        );
        if (image) {
          await removeImage(old?.image, UPLOAD_DIR);
          await removeThumbs(old?.image);
        }
      } else {
        db.prepare(
          'INSERT INTO event (title, description, event_date, location, rating, image, image_w, image_h) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
        ).run(title, description, eventDate, location, rating, image, size?.width ?? null, size?.height ?? null);
      }
      return Astro.redirect('/admin', 303);
    } catch (e) {
      // lib โยนคีย์มา ไม่ใช่ประโยค — error อื่นที่ไม่มีในดิกจะโผล่ข้อความดิบตามเดิม
      error = t(e instanceof Error ? e.message : 'err.saveFailed');
    }
  }
}

const editId = Number(Astro.url.searchParams.get('edit')) || null;
const editing = editId ? db.prepare('SELECT * FROM event WHERE id = ?').get(editId) : null;
const events = db.prepare('SELECT * FROM event ORDER BY event_date DESC, id DESC').all();

const label = 'grid gap-1.5 text-[12.5px] leading-[1.8]';
const input =
  'min-h-11 w-full rounded-[14px] border border-line bg-field px-3.5 py-2.5 text-[15px] leading-[1.6] text-text outline-none focus:border-accent';
const pill =
  'inline-flex min-h-9 flex-none items-center rounded-full border px-3.5 text-[12.5px] font-medium whitespace-nowrap';
const hatch =
  'bg-[repeating-linear-gradient(135deg,var(--line)_0_8px,var(--field)_8px_16px)]';
---

<Base title={editing ? t('admin.edit') : t('admin.new')}>
  <Nav current="admin" />

  <main class="mx-auto w-full max-w-2xl px-5 py-7 sm:px-9 sm:py-9">
    <h1 class="mt-6 mb-4 font-display text-[22px] leading-[1.45] text-text sm:text-[24px]">
      {editing ? t('admin.edit') : t('admin.new')}
    </h1>

    {
      error && (
        <p class="mb-4 rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-3 text-[13.5px] text-accent-ink">
          {error}
        </p>
      )
    }

    <form
      method="post"
      enctype="multipart/form-data"
      class="grid gap-3.5 rounded-[24px] border border-line bg-surface p-5 shadow-[0_3px_10px_rgba(133,41,54,0.12)] sm:gap-4 sm:rounded-[26px] sm:p-[26px]"
    >
      {editing && <input type="hidden" name="id" value={editing.id} />}

      <div class="grid gap-3.5 sm:grid-cols-[180px_1fr]">
        <label class={label}>
          {t('admin.date')}
          {/* iOS แสดงวันนี้ในช่องว่างจนดูเหมือนกรอกแล้ว แต่ value ยังว่าง กดบันทึกจะโดน error งง ๆ
            ใส่วันนี้เป็นค่าตั้งต้นไปเลย ตรงกับที่ตาเห็นและเป็นค่าที่ใช้บ่อยที่สุดอยู่แล้ว */}
        <input
          class={input}
          type="date"
          name="event_date"
          value={editing?.event_date ?? todayISO()}
          required
        />
        </label>
        <label class={label}>
          {t('admin.place')}
          <input
            class={input}
            type="text"
            name="location"
            value={editing?.location ?? ''}
            placeholder={t('admin.optional')}
          />
        </label>
      </div>

      <label class={label}>
        {t('admin.title')}
        <input
          class={input}
          type="text"
          name="title"
          value={editing?.title ?? ''}
          placeholder={t('admin.titleHint')}
          required
        />
      </label>

      <fieldset class="grid gap-2 text-[12.5px] leading-[1.8]">
        <legend class="mb-1">{t('admin.rate')}</legend>
        <div class="flex items-center gap-4">
          <div class="stars">
            {
              [5, 4, 3, 2, 1].map((n) => (
                <>
                  <input
                    type="radio"
                    name="rating"
                    id={`star-${n}`}
                    value={n}
                    checked={editing?.rating === n}
                  />
                  <label for={`star-${n}`}>{t('admin.starN', n)}</label>
                </>
              ))
            }
          </div>
          <label class="flex items-center gap-1.5 text-muted">
            <input type="radio" name="rating" value="0" checked={!editing?.rating} />
            {t('admin.noStars')}
          </label>
        </div>
      </fieldset>

      <label class={label}>
        {t('admin.story')}
        <textarea
          class={`${input} min-h-0 resize-y rounded-2xl leading-[1.9]`}
          name="description"
          rows="4"
          placeholder={t('admin.optional')}>{editing?.description ?? ''}</textarea>
      </label>

      <label class="grid gap-2 text-[12.5px] leading-[1.8]">
        {t('admin.photo')}
        <span
          class:list={[
            'flex items-center gap-3.5 rounded-2xl p-3.5',
            editing ? 'border border-line bg-field' : 'border-[1.5px] border-dashed border-accent/40 bg-field',
          ]}
        >
          {
            editing?.image ? (
              <img
                src={`/uploads/${editing.image}?s=sm`}
                alt=""
                loading="lazy"
                decoding="async"
                onload="this.classList.remove('skeleton')"
                class="skeleton size-14 flex-none rounded-xl object-cover object-[50%_25%] sm:h-[62px] sm:w-[82px]"
              />
            ) : (
              <span class={`block size-11 flex-none rounded-xl ${hatch}`} />
            )
          }
          <span class="flex-1 text-muted">
            {editing ? t('admin.keepPhoto') : t('admin.photoHint')}
            <input
              class="mt-1.5 block w-full text-[12.5px] text-muted file:mr-2.5 file:rounded-full file:border-0 file:bg-accent file:px-3 file:py-1.5 file:text-[12px] file:font-medium file:text-on-accent"
              type="file"
              name="image"
              accept="image/jpeg,image/png,image/webp,image/gif"
            />
          </span>
        </span>
      </label>

      <div class="flex items-center justify-end gap-4">
        {
          editing && (
            <a href="/admin" class="text-[13px] text-accent-ink underline underline-offset-4">
              {t('admin.cancel')}
            </a>
          )
        }
        <button
          class="min-h-12 flex-1 rounded-full bg-accent px-6 text-[15.5px] font-medium text-on-accent sm:min-h-11 sm:flex-none"
        >
          {editing ? t('admin.saveEdit') : t('admin.save')}
        </button>
      </div>
    </form>

    {
      events.length > 0 && (
        <>
          <h2 id="list" class="mt-8 mb-3 scroll-mt-20 font-display text-[18px] leading-[1.5] text-text">
            {t('admin.saved', events.length)}
          </h2>
          <ul class="grid gap-2.5">
            {events.map((e) => (
              <li
                class="flex min-w-0 items-center gap-2.5 rounded-[18px] border border-line bg-surface p-3 sm:gap-3"
              >
                {e.image ? (
                  <img
                    src={`/uploads/${e.image}?s=sm`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    onload="this.classList.remove('skeleton')"
                    class="skeleton size-12 flex-none rounded-xl object-cover object-[50%_25%]"
                  />
                ) : (
                  <span class="flex size-12 flex-none items-center justify-center rounded-xl bg-alt/25 font-mono text-[9.5px] text-alt-muted">
                    {t('admin.noPhoto')}
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[14.5px] leading-[1.6] text-text">{e.title}</span>
                  <span class="flex items-center gap-2 font-mono text-[10.5px] leading-[1.7] text-muted">
                    {e.event_date}
                    {
                      e.rating && (
                        <span class="text-accent" aria-label={t('admin.starsShort', e.rating)}>
                          <span aria-hidden="true">{'★'.repeat(parseRating(e.rating) ?? 0)}</span>
                        </span>
                      )
                    }
                  </span>
                </span>
                <a
                  href={`/admin?edit=${e.id}`}
                  class={`${pill} border-accent-ink/35 text-accent-ink`}
                >
                  {t('admin.editShort')}
                </a>
                <form method="post" onsubmit={`return confirm(${JSON.stringify(t('admin.confirmDelete'))})`}>
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="id" value={e.id} />
                  <button class={`${pill} border-accent-ink/30 text-accent-ink`}>{t('admin.delete')}</button>
                </form>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </main>
</Base>
