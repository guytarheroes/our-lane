---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
import { db } from '../lib/db.js';
import { COOKIE, hash, sign } from '../lib/auth.js';
import { reset, tooMany } from '../lib/ratelimit.js';
import { LANG_COOKIE, dict, validLang } from '../lib/i18n.js';

const t = dict(validLang(Astro.cookies.get(LANG_COOKIE)?.value));

if (Astro.locals.userId) return Astro.redirect('/');

// ponytail: เว็บของคู่รัก = 2 บัญชี — นี่คือระบบสิทธิ์ทั้งหมดที่มี ไม่ต้องมีระบบ invite
// เช็คทุกครั้งที่ POST ด้วย ไม่ใช่แค่ตอน render ไม่งั้นยิงตรงมาก็สมัครคนที่ 3 ได้
const { n } = db.prepare('SELECT COUNT(*) AS n FROM user').get();
const canRegister = n < 2;

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const name = String(form.get('name') ?? '').trim().slice(0, 60);
  const ip = Astro.clientAddress || 'unknown';

  if (tooMany(ip)) {
    error = t('err.rateLimit');
  } else if (!canRegister) {
    error = t('err.registerFull');
  } else if (!email.includes('@') || password.length < 8) {
    error = t('err.badEmailOrPassword');
  } else {
    try {
      const { lastInsertRowid } = db
        .prepare('INSERT INTO user (email, password, name) VALUES (?, ?, ?)')
        .run(email, hash(password), name || null);
      reset(ip);
      Astro.cookies.set('session', sign(Number(lastInsertRowid), 0), COOKIE);
      return Astro.redirect('/');
    } catch {
      // UNIQUE constraint บนคอลัมน์ email เป็นตัวกันซ้ำจริง ไม่ใช่การเช็คก่อน insert
      error = t('err.emailTaken');
    }
  }
}

const label = 'grid gap-1.5 text-[13px] leading-[1.8] text-body';
const input =
  'min-h-12 w-full rounded-2xl border border-line bg-field px-4 text-[15px] leading-[1.6] text-text outline-none focus:border-accent';
---

<Base title={`${t('auth.register')} · Our Memory Lane`}>
  <AuthShell
    title={canRegister ? t('auth.createAccount') : t('auth.registerFull')}
    subtitle={canRegister ? t('auth.registerSub', 2 - n) : t('auth.registerFullSub')}
  >
    {
      error && (
        <p class="mt-6 rounded-2xl border border-accent-ink/35 bg-accent/10 px-4 py-3 text-[13.5px] text-accent-ink">
          {error}
        </p>
      )
    }

    {
      canRegister && (
        <form method="post" class="mt-7 grid gap-4">
          <label class={label}>
            {t('auth.name')} <span class="text-muted">{t('auth.optional')}</span>
            <input class={input} type="text" name="name" autocomplete="name" maxlength="60" />
          </label>
          <label class={label}>
            {t('auth.email')}
            <input
              class={input}
              type="email"
              name="email"
              autocomplete="username"
              inputmode="email"
              required
            />
          </label>
          <label class={label}>
            {t('auth.password')} <span class="text-muted">{t('set.minLen')}</span>
            <input
              class={input}
              type="password"
              name="password"
              minlength="8"
              autocomplete="new-password"
              required
            />
          </label>
          <button class="mt-1 min-h-12 rounded-full bg-accent px-6 text-[15.5px] font-medium text-on-accent">
            {t('auth.createAccount')}
          </button>
        </form>
      )
    }

    <p class="mt-7 text-[13.5px] text-muted">
      {t('auth.haveAccount')}{' '}
      <a href="/login" class="font-medium text-accent-ink underline underline-offset-4">
        {t('auth.login')}
      </a>
    </p>
  </AuthShell>
</Base>
